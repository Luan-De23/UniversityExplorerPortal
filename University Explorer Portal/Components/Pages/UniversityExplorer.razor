@page "/university-explorer"
@inject CountryService CountryService
<h1>UniversityExplorer</h1>

@if (_isLoading)
{
    <p> Loading... </p>
}
else if (_hasError)
{
    <div class="alert alert-danger text-center">@_errorMenssage</div>
}
else
{
    <div>
        <select class="form-select" @bind="@_selectedCountryName" >
            <option value=""> Select Country </option>
            @foreach (Country country in _countries)
            {
                <option>@country.Name</option>
            }
        </select>
    </div>

    if ( SelectedCountry!= null)
    {
        <div>
            <CountryDetails SelectedCountry="SelectedCountry"></CountryDetails>
        </div> 
    }
    else
    {
        <p class="alert alert-info"> No Country Selected </p>
    }
    
    
}

@code
{
    // empty list
    private List<Country> _countries = new List<Country>();
    private List<Country> _loadList = new List<Country>();

    private string? _selectedCountryName;
    public Country? SelectedCountry => _countries.FirstOrDefault(c => c.Name == _selectedCountryName);
    
    private bool _isLoading = true;
    private bool _hasError;
    private readonly string _errorMenssage = "Loading Error";
    protected override async Task OnInitializedAsync()
    {
        

        try
        {
            // Load the list
            _loadList = await CountryService.GetCountriesAsync();
            _countries = _loadList.OrderBy(c => c.Name ).ToList();

        }
        catch(Exception e)
        {
                _hasError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
