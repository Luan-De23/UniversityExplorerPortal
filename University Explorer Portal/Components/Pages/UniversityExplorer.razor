@page "/university-explorer"
@inject CountryService CountryService
@inject UniversityService UniversityService
<h1>UniversityExplorer</h1>

@if (_isLoadingCountry)
{
    <p class="alert alert-info"> Loading... </p>
}
else if (_hasError)
{
    <div class="alert alert-danger text-center">@_errorMenssage</div>
}
else
{
    <div>
        <select class="form-control" @bind="@_selectedCountryName" @bind:after="LoadUniversitiesAsync">
            <option value=""> Select Country </option>
            @foreach (Country country in _countries)
            {
                <option>@country.Name</option>
            }
        </select>
    </div>

    if ( SelectedCountry!= null)
    {
        <div>
            <CountryDetails SelectedCountry="SelectedCountry"></CountryDetails>
        </div>

        if (_isLoadingUniversity)
        {
            <p class="alert alert-info"> Loading universities... </p>

        }
        else if (_hasErrorUniversity)
        {
            <div class="alert alert-danger text-center">@_errorMenssage</div>
        }
        else
        {
            if (_selectedUniversity != null)
            {
                <UniversityDetails SelectedUniversity="_selectedUniversity" ></UniversityDetails>
            }
            
            if (_universities.Count > 0)
            {
                <input @bind="_searchText" @bind:event="oninput" class="form-control" placeholder="Search..."/>

            }
            if (FilteredUniversities.Count <= 0 || _universities.Count <= 0)
            {
                <p class="alert alert-info"> No Universities </p>
            }
            else
            {
                foreach (var uni in FilteredUniversities)
                {
                    <UniversityCard UniversityItem="uni" OnSelect="GetUniversity"></UniversityCard>
                }
        
            }
        }
    }
    else
    {
        <p class="alert alert-info"> No Country Selected </p>
    }

   
    
    
}

@code
{
    public List<University> FilteredUniversities => 
        _universities.Where(u => u.Name.Contains(
            _searchText, StringComparison.OrdinalIgnoreCase)).ToList();
    
    // empty list
    private List<Country> _countries = new List<Country>();
    private List<Country> _loadList = new List<Country>();
    
    private List<University> _universities = new List<University>();

    private University? _selectedUniversity;
    private string _searchText = "";
    private string? _selectedCountryName;
    public Country? SelectedCountry => _countries.FirstOrDefault(c => c.Name == _selectedCountryName);
    
    private bool _isLoadingCountry = true;
    private bool _isLoadingUniversity;
    
    private bool _hasError;
    private bool _hasErrorUniversity;
    
    private readonly string _errorMenssage = "Loading Error";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load the list
            _loadList = await CountryService.GetCountriesAsync();
            _countries = _loadList.OrderBy(c => c.Name ).ToList();
            

        }
        catch(Exception e)
        {
                _hasError = true;
        }
        finally
        {
            _isLoadingCountry = false;
            

        }
    }


    
    public async Task LoadUniversitiesAsync()
    {
        
        try
        {
            _searchText = "";
            _selectedUniversity = null;
            if (string.IsNullOrEmpty(_selectedCountryName))
            {
                _universities.Clear();
                return;
            }
            else
            {
                _isLoadingUniversity = true;
                _hasErrorUniversity = false;
                _universities = await UniversityService.GetUniversityAsync(_selectedCountryName);
                
                
            }
        }
        catch (Exception e)
        {
            _hasErrorUniversity = true;
        }  
        finally
        {
            _isLoadingUniversity = false;
        }
    }

    private  void GetUniversity(University university)
    {
        _selectedUniversity = university ;
    }
    
}
